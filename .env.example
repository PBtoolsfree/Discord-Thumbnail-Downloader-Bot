# Discord Bot Configuration
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_GUILD_ID=your_guild_id_here
THUMBNAIL_CHANNEL_ID=your_channel_id_here

# Limits & Features
MAX_URLS_PER_MESSAGE=5
MAX_IMAGE_SIZE_MB=8
CACHE_TTL_HOURS=24
MAX_CONCURRENT_DOWNLOADS=3
REQUEST_TIMEOUT=15

# Logging
LOG_LEVEL=INFO

# Web Setup Wizard
SETUP_ENABLED=true
SETUP_PASSWORD=change_this_default_password
SETUP_PORT=8080
